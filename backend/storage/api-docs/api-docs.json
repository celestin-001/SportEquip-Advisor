{
    "openapi": "3.0.0",
    "info": {
        "title": "SportEquip API",
        "description": "Documentation des endpoints de SportEquip",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080/api",
            "description": "Serveur local"
        }
    ],
    "paths": {
        "/api/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Créer un nouvel utilisateur",
                "operationId": "8e4e3cb7b46126f4696379d3c7eeb4ad",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Utilisateur créé avec succès"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Connexion utilisateur",
                "operationId": "222b2625838e3c57e017987f73598fda",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Connexion réussie"
                    },
                    "401": {
                        "description": "Identifiants invalides"
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Déconnexion utilisateur",
                "operationId": "ad65cbbd4e9f201619eae184a5961a98",
                "responses": {
                    "200": {
                        "description": "Déconnexion réussie"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Récupérer tous les produits",
                "operationId": "d97d1c3727cbac49708b85f7d11f7d58",
                "responses": {
                    "200": {
                        "description": "Liste de tous les produits"
                    }
                }
            }
        },
        "/api/products/sport/{sport_id}": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Récupérer les produits par sport",
                "operationId": "af623a27cd8e15b9b945c5d87b0b24a7",
                "parameters": [
                    {
                        "name": "sport_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Liste des produits pour un sport donné"
                    }
                }
            }
        },
        "/api/products/user-sport": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Récupérer les produits correspondant au sport de l'utilisateur",
                "operationId": "73c1f7dd0a2ce810663f23357b67ca92",
                "responses": {
                    "200": {
                        "description": "Liste des produits"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/sports": {
            "get": {
                "tags": [
                    "Sports"
                ],
                "summary": "Récupérer tous les sports",
                "operationId": "53670591c15c3c0b83a5c67f97d2ae54",
                "responses": {
                    "200": {
                        "description": "Liste de tous les sports"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Endpoints pour la gestion des utilisateurs"
        },
        {
            "name": "Products",
            "description": "Endpoints pour gérer les produits"
        },
        {
            "name": "Sports",
            "description": "Endpoints pour les sports"
        }
    ],
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "apiKey",
                "description": "Utiliser le token de Sanctum pour sécuriser les endpoints",
                "name": "Authorization",
                "in": "header"
            }
        }
    }
}